---
import '../styles/global.css';
interface Props { title: string; description: string; path?: string }
const { title, description, path = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = 'https://mrigankad.github.io/Ankana';
const canonical = `${site}${path}`;
const og = `${site}/og.png`;
const fontCss = `
@font-face{font-family:"Urbanist";src:url("${base}/fonts/Urbanist-VF.woff2") format("woff2");font-weight:100 900;font-style:normal;font-display:swap}
@font-face{font-family:"Noto Serif Devanagari";src:url("${base}/fonts/NotoSerifDevanagari-Ankana.woff2") format("woff2");font-weight:100 900;font-style:normal;font-display:swap}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#D32704" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="preload" href={`${base}/fonts/Urbanist-VF.woff2`} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ankana" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ankana, the Jyotish practice workspace" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <style set:html={fontCss}></style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
