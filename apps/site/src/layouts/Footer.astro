---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/mrigankad/Ankana';
---
<footer>
  <div class="wrap">
    <div class="foot-top">
      <div>
        <a class="logo" href={`${base}/`} aria-label="Ankana home">
          <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M13 56 V31 A19 19 0 0 1 51 31 V56" fill="none" stroke="#FC826B" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="32" cy="40" r="6.5" fill="#FC826B"/></svg>
          <span>ankana</span>
        </a>
        <p>The Jyotish practice workspace. Open source under AGPL-3.0.</p>
      </div>
      <div class="foot-cols">
        <div>
          <h4>Project</h4>
          <ul>
            <li><a href={repo}>Source code</a></li>
            <li><a href={`${repo}/blob/main/LICENSE`}>Licence</a></li>
            <li><a href={`${base}/docs/`}>Docs</a></li>
          </ul>
        </div>
        <div>
          <h4>Learn</h4>
          <ul>
            <li><a href={`${base}/#features`}>Features</a></li>
            <li><a href={`${base}/#how-it-works`}>How it works</a></li>
            <li><a href={`${base}/#lal-kitab`}>Lal Kitab</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <p>Advisory only. Charts, timing and readings are interpretive guidance. They are not medical, legal or financial advice.</p>
      <p class="dim">Licensed under AGPL-3.0-only. <span class="deva" lang="hi">अंकन</span> (ankana)</p>
    </div>
  </div>
</footer>
