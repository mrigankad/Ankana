---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { home = false } = Astro.props;
const p = home ? '' : `${base}/`;
const links = [
  { href: `${p}#features`, label: 'Features' },
  { href: `${p}#how-it-works`, label: 'How it works' },
  { href: `${p}#lal-kitab`, label: 'Lal Kitab' },
  { href: `${base}/docs/`, label: 'Docs' },
];
const repo = 'https://github.com/mrigankad/Ankana';
---
<header class="nav">
  <div class="wrap">
    <a class="logo" href={`${base}/`} aria-label="Ankana home">
      <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M13 56 V31 A19 19 0 0 1 51 31 V56" fill="none" stroke="#D32704" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="32" cy="40" r="6.5" fill="#D32704"/></svg>
      <span>ankana</span>
    </a>
    <nav class="nav-links" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="gh" href={repo}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5C5.7.5.6 5.6.6 11.9c0 5 3.3 9.3 7.8 10.8.6.1.8-.3.8-.6v-2c-3.2.7-3.8-1.5-3.8-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.5-1.5 7.8-5.8 7.8-10.8C23.4 5.600 18.300.5 12 .5z"/></svg>
      <span>GitHub</span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
      <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true"><path d="M1 1H19M1 7H19M1 13H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
    </button>
  </div>
  <nav class="menu" id="menu" aria-label="Mobile">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href={repo}>GitHub</a>
  </nav>
</header>
<script is:inline>
  (function () {
    var b = document.querySelector('.menu-btn'), m = document.getElementById('menu');
    if (!b || !m) return;
    function set(o) { m.classList.toggle('open', o); b.setAttribute('aria-expanded', String(o)); b.setAttribute('aria-label', o ? 'Close menu' : 'Open menu'); }
    b.addEventListener('click', function () { set(!m.classList.contains('open')); });
    m.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
  })();
</script>
