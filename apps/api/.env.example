# ── Nakshatra API (apps/api) ───────────────────────────────────────
# Copy to .env and fill in values. Never commit .env.

# SQLite database file (relative to apps/api). Your data stays local.
DATABASE_URL="file:./dev.db"
PORT=3001

# ── Ollama (chart AI assistant) ────────────────────────────────────
# Cloud: https://ollama.com  — or local daemon http://127.0.0.1:11434
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3:32b

# Deterministic mock (CI / offline). Chart math still works without a model.
# OLLAMA_MOCK=1

# ── PDF reports (Playwright renders the web print route) ───────────
WEB_BASE_URL=http://localhost:3000
# REPORT_RENDERER=stub

# ── Locations ──────────────────────────────────────────────────────
# LOCATION_PROVIDER=static
