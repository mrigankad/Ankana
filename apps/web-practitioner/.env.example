# ── Nakshatra web practitioner (apps/web-practitioner) ─────────────
# Copy to .env.local for local overrides. Never commit real secrets.

# Node API base URL used by the browser
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# Built-in sign-in (services/api-py). Leave unset to keep fixture/dev-token mode
# with no sign-in screens; set to "builtin" to require sign-in on every page.
# NEXT_PUBLIC_AUTH_MODE=builtin
