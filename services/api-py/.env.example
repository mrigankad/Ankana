# ── Nakshatra Python engine (services/api-py) ───────────────────────
# Optional. Copy to .env if you run the FastAPI service directly.
# The Node API also shells out to tools/build-reading.py via .venv.

# SQLITE DB for the Python service (if used)
# DATABASE_URL=sqlite:///./data/api.db

# Host / port when running uvicorn locally
# HOST=127.0.0.1
# PORT=8000

# ── Tenant layer (Postgres, RLS, auth) ──────────────────────────────
# App connection: non-superuser role ankana_app, subject to RLS.
# API_DATABASE_URL=postgresql+psycopg://ankana_app:ankana_app_dev@localhost:5432/ankana
# Owner connection, used only by `alembic upgrade head`.
# API_MIGRATION_URL=postgresql+psycopg://ankana:ankana_dev@localhost:5432/ankana
# API_ENV=dev                      # dev | test | production
# Local login without a provider (refused when API_ENV=production):
# AUTH_DEV_STUB=1
# Hosted provider (any OIDC issuer that publishes a JWKS):
# AUTH_JWKS_URL=https://<tenant>/.well-known/jwks.json
# AUTH_ISSUER=https://<tenant>/
# AUTH_AUDIENCE=ankana-api

# ── Built-in auth (see docs/deploy.md step 5) ───────────────────────
# AUTH_BUILTIN_ISSUER=http://127.0.0.1:8000   # public API URL, becomes token iss
# AUTH_WEB_BASE_URL=http://localhost:3000
# AUTH_ALLOWED_ORIGINS=http://localhost:3000
# AUTH_SIGNING_KEY_PEM=                        # required in production; dev key is auto-generated
# AUTH_MAILER=console                          # console | smtp | acs
# AUTH_MAIL_FROM=Ankana <no-reply@example.com>
# ACS_EMAIL_CONNECTION_STRING=endpoint=https://<acs>.communication.azure.com/;accesskey=...
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD=
# AUTH_SIGNUP_ENABLED=1
# AUTH_PASSWORD_ENABLED=1
# AUTH_OIDC_PROVIDERS=keycloak
# AUTH_OIDC_KEYCLOAK_ISSUER=https://sso.example.com/realms/ankana
# AUTH_OIDC_KEYCLOAK_CLIENT_ID=ankana
# AUTH_OIDC_KEYCLOAK_CLIENT_SECRET=

# ── Observability (all optional; see src/app/observability.py) ──────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
# OTEL_SERVICE_NAME=ankana-api
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# RELEASE_SHA=
# LOG_LEVEL=INFO
# ── Reports, storage, worker ────────────────────────────────────────
# STORAGE_BACKEND=local            # local | azure
# STORAGE_LOCAL_DIR=./data/storage
# STORAGE_SIGNING_KEY=             # required when API_ENV=production, 24+ random characters
# ANKANA_SECRET_KEY=               # encrypts stored AI keys; 32+ random characters in production
# STORAGE_PUBLIC_BASE_URL=http://localhost:8000
# AZURE_STORAGE_CONNECTION_STRING= # or AZURE_STORAGE_ACCOUNT_URL (managed identity)
# AZURE_STORAGE_CONTAINER=ankana-private
# Worker: python -m app.worker  (needs `python -m playwright install chromium` locally)
# WORKER_CONCURRENCY=2
# WORKER_POLL_SECONDS=1.0
# WORKER_VISIBILITY_SECONDS=900

# ── Messaging (docs/deploy.md step 6a). Console backends never send. ─
# NOTIFY_EMAIL_BACKEND=console        # console | smtp | acs
# NOTIFY_EMAIL_FROM=reminders@example.com
# ACS_EMAIL_FROM=no-reply@example.azurecomm.net
# ACS_EMAIL_USE_SDK=0                 # 1 needs the azure-email extra
# NOTIFY_WHATSAPP_BACKEND=console     # console | meta | gupshup | off (console refused in production)
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v21.0
# WHATSAPP_APP_SECRET=                # verifies X-Hub-Signature-256
# WHATSAPP_VERIFY_TOKEN=              # webhook GET handshake
# WHATSAPP_TEMPLATES={"remedy_due":{"en":{"name":"remedy_due_en","language":"en"}}}
# GUPSHUP_API_KEY= GUPSHUP_SOURCE= GUPSHUP_APP_NAME= GUPSHUP_WEBHOOK_TOKEN=
# NOTIFY_SMS_BACKEND=console          # console | msg91 | twilio | off (console refused in production)
# AUTH_SMS=console                    # none | console | msg91 | twilio
# MSG91_AUTH_KEY= MSG91_SENDER_ID=    # sender id = DLT registered header
# MSG91_DLT_TEMPLATE_ID=              # default DLT template id
# MSG91_DLT_TEMPLATES={"otp":"<dlt id>","remedy_due":"<dlt id>"}
# MSG91_WEBHOOK_TOKEN=
# TWILIO_ACCOUNT_SID= TWILIO_AUTH_TOKEN= TWILIO_FROM= TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_STATUS_CALLBACK_URL=
# MESSAGING_PUBLIC_BASE_URL=https://api.example.com
# MESSAGING_DEFAULT_COUNTRY_CODE=91
