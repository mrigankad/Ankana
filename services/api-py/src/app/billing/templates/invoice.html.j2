<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Tax invoice {{ inv.number }}</title>
<style>
{{ font_css|safe }}
:root { --ink: {{ ink }}; --accent: {{ accent }}; --body: #534f4d; --soft: #6c6866; --rule: #eae5e3; --wash: #fff4f2; }
* { box-sizing: border-box; }
body { font-family: 'Urbanist', system-ui, sans-serif; color: var(--ink); font-size: 11.5px; line-height: 1.5; margin: 0; }
h1 { font-size: 30px; line-height: 1.1; margin: 4px 0 0; color: var(--ink); font-weight: 800; }
.brand { font-size: 13px; font-weight: 800; color: var(--accent); letter-spacing: .04em; }
.top { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 3px solid var(--ink); padding: 8mm 0 6mm; margin-bottom: 18px; }
.meta { text-align: right; }
.meta .num { font-size: 16px; font-weight: 800; color: var(--ink); }
.meta .sub { color: var(--body); }
.parties { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 18px; }
.box { border: 1px solid var(--rule); border-radius: 10px; padding: 10px 12px; break-inside: avoid; }
.k { color: var(--soft); font-size: 9.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
.v { font-size: 13px; font-weight: 700; margin: 2px 0 4px; }
.small { color: var(--body); }
table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
th { text-align: left; font-size: 9.5px; color: var(--soft); text-transform: uppercase; letter-spacing: .05em; border-bottom: 1px solid var(--rule); padding: 6px; }
td { padding: 8px 6px; border-bottom: 1px solid var(--rule); vertical-align: top; }
th.r, td.r { text-align: right; }
tr { break-inside: avoid; }
.totals { margin-left: auto; width: 62%; }
.totals td { border: 0; padding: 4px 6px; }
.totals tr.grand td { border-top: 2px solid var(--accent); font-size: 15px; font-weight: 800; padding-top: 8px; }
.note { color: var(--body); font-size: 10px; margin-top: 18px; border-top: 1px solid var(--rule); padding-top: 8px; }
.pill { display: inline-block; background: var(--wash); color: #871200; font-weight: 700; border-radius: 6px; padding: 1px 8px; font-size: 10px; }
</style>
</head>
<body>
<header class="top">
  <div>
    <div class="brand">{{ supplier.name }}</div>
    <h1>Tax invoice</h1>
  </div>
  <div class="meta">
    <div class="num">{{ inv.number }}</div>
    <div class="sub">Date {{ issued }}</div>
    <div class="sub">Financial year {{ fy_long }}</div>
  </div>
</header>

<div class="parties">
  <div class="box">
    <div class="k">Supplier</div>
    <div class="v">{{ supplier.name }}</div>
    {% if supplier.gstin %}<div class="small">GSTIN {{ supplier.gstin }}</div>{% endif %}
    {% if supplier.address %}<div class="small">{{ supplier.address }}</div>{% endif %}
    <div class="small">State code {{ supplier.state_code }}</div>
  </div>
  <div class="box">
    <div class="k">Billed to</div>
    <div class="v">{{ recipient.name }}</div>
    {% if recipient.gstin %}<div class="small">GSTIN {{ recipient.gstin }}</div>{% endif %}
    {% if recipient.address %}<div class="small">{{ recipient.address }}</div>{% endif %}
    <div class="small">State {{ recipient_state }}</div>
  </div>
</div>

<div class="parties">
  <div class="box"><div class="k">Place of supply</div><div class="v">{{ place_name }}</div></div>
  <div class="box"><div class="k">Supply type</div><div class="v">{{ "Intra state (CGST and SGST)" if inv.intra_state else "Inter state (IGST)" }}</div></div>
</div>

<table>
  <thead><tr><th>#</th><th>Description</th><th>SAC</th><th class="r">Qty</th><th class="r">Taxable value (INR)</th></tr></thead>
  <tbody>
  {% for l in lines %}
    <tr><td>{{ l.position }}</td><td>{{ l.description }}</td><td>{{ l.sac }}</td><td class="r">{{ l.quantity }}</td><td class="r">{{ l.taxable_paise|inr }}</td></tr>
  {% endfor %}
  </tbody>
</table>

<table class="totals">
  <tr><td>Taxable value</td><td class="r">{{ inv.taxable_paise|inr }}</td></tr>
  {% if inv.intra_state %}
  <tr><td>CGST at {{ "%.1f"|format(lines[0].tax_rate_bp / 200) }} percent</td><td class="r">{{ inv.cgst_paise|inr }}</td></tr>
  <tr><td>SGST at {{ "%.1f"|format(lines[0].tax_rate_bp / 200) }} percent</td><td class="r">{{ inv.sgst_paise|inr }}</td></tr>
  {% else %}
  <tr><td>IGST at {{ "%.1f"|format(lines[0].tax_rate_bp / 100) }} percent</td><td class="r">{{ inv.igst_paise|inr }}</td></tr>
  {% endif %}
  <tr class="grand"><td>Total (INR)</td><td class="r">{{ inv.total_paise|inr }}</td></tr>
</table>

<p><span class="pill">Paid</span> Payment reference {{ inv.provider_payment_id }}</p>
<div class="note">
  Amounts are in Indian rupees and rounded to the paisa. The charged amount includes GST; the taxable value is
  the charged amount divided by one plus the GST rate, rounded half up to the paisa, and the tax is the remainder.
  This is a computer generated invoice and needs no signature.
</div>
</body>
</html>
