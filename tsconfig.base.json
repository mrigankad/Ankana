{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@astro/shared-types": ["./packages/shared-types/src/index.ts"],
      "@astro/shared-config": ["./packages/shared-config/src/index.ts"]
    }
  }
}
